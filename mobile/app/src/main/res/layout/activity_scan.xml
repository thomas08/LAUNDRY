<?xml version="1.0" encoding="utf-8"?>
<!-- focusable* บน root: ให้ตัว root รับ focus แรกแทน EditText ลูก
     (ในโหมดลงทะเบียน ช่อง "จำนวนชิ้น" เป็น EditText ตัวแรกในหน้า มันจะแย่ง focus
      อัตโนมัติแล้วดันคีย์บอร์ดขึ้นมาบังจอ) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- Colored header: back + mode name -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mode_dispatch"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnBack"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="@string/back"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/modeHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingEnd="56dp"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ทุกอย่างใต้ header อยู่ใน ScrollView:
         จอ C72 เตี้ย ของที่สูงคงที่ (ตัวเลือก + ปุ่มใหญ่ 2 ปุ่ม + ช่องพิมพ์) เคยกินพื้นที่จนบล็อก
         เลขนับเหลือความสูงเกือบศูนย์ เลขเลยโดนตัดหายไป ตอนนี้ถ้าจอไม่พอจะเลื่อนได้ (ปุ่มบันทึก
         ไม่มีทางหลุดจอ) และ fillViewport ทำให้จอที่สูงพอ บล็อกเลขนับยังขยายเต็มที่เหมือนเดิม -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Context pickers (shown per mode) -->
            <LinearLayout
                android:id="@+id/extras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp">

                <!-- Locked context when linked to a web station (REGISTER only) -->
                <TextView
                    android:id="@+id/stationContext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelArticle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_article"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spinnerArticle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/ownershipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <RadioButton
                        android:id="@+id/rbRental"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/own_rental" />

                    <RadioButton
                        android:id="@+id/rbCog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/own_cog" />
                </RadioGroup>

                <TextView
                    android:id="@+id/labelCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_customer"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spinnerCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelJobOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_joborder"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spinnerJobOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:visibility="gone" />

                <!-- Manual key-in: add N non-RFID pieces without scanning (REGISTER only) -->
                <LinearLayout
                    android:id="@+id/manualGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_qty_label"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/qtyInput"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:hint="0"
                        android:imeOptions="actionDone"
                        android:inputType="number" />

                    <Button
                        android:id="@+id/qtyAddBtn"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/manual_qty_add" />
                </LinearLayout>
            </LinearLayout>

            <!-- Big count. countBig กินพื้นที่ที่เหลือแล้วย่อ/ขยายตัวเองอัตโนมัติ (autoSize)
                 ให้พอดีจอเสมอ ไม่ว่าเครื่องจะสูงเท่าไร -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="96dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/countBig"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:text="0"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="96sp"
                    app:autoSizeMinTextSize="28sp"
                    app:autoSizeStepGranularity="2sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_count_label"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lastTag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/pull_trigger"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <Button
                    android:id="@+id/scanToggle"
                    style="@style/BigTile"
                    android:backgroundTint="#4B5563"
                    android:text="@string/scan_start" />

                <Button
                    android:id="@+id/saveBtn"
                    style="@style/BigTile"
                    android:backgroundTint="@color/ok_green"
                    android:text="@string/save_btn" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/tagInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_tag"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters" />

                    <Button
                        android:id="@+id/addBtn"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add" />

                    <Button
                        android:id="@+id/clearBtn"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
