<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/homeBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="@string/home_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDispatch"
            style="@style/BigTile"
            android:backgroundTint="@color/mode_dispatch"
            android:text="📤  จ่ายออก" />

        <Button
            android:id="@+id/btnReturn"
            style="@style/BigTile"
            android:backgroundTint="@color/mode_return"
            android:text="📥  รับคืน" />

        <Button
            android:id="@+id/btnWash"
            style="@style/BigTile"
            android:backgroundTint="@color/mode_wash"
            android:text="🧺  ส่งซัก" />

        <Button
            android:id="@+id/btnStock"
            style="@style/BigTile"
            android:backgroundTint="@color/mode_stock"
            android:text="🔢  ตรวจนับ" />

        <Button
            android:id="@+id/btnRegister"
            style="@style/BigTile"
            android:backgroundTint="@color/mode_register"
            android:text="➕  ลงทะเบียน" />

        <Button
            android:id="@+id/btnLogout"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/logout_th"
            android:textColor="#888888" />
    </LinearLayout>
</ScrollView>
