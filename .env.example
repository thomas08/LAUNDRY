# ── LinenFlow™ frontend (Next.js) environment ───────────────────────────────
# Copy to .env.local for local development.

# Base URL of the backend API, including the /v1 prefix.
# This is inlined into the client bundle at build time (NEXT_PUBLIC_*).
# Local dev default (backend `npm run dev`):
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
