# ── docker-compose.prod.yml environment ─────────────────────────────────────
# Copy to .env.prod and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# NEVER commit the real .env.prod.

# Public domain (DNS A record must point at this server's public IP).
# Caddy obtains a Let's Encrypt cert for it automatically.
DOMAIN=your-domain.example
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Database (shared by the postgres + backend services)
DB_NAME=linenflow
DB_USER=linenflow
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM

# First-run superadmin password (admin@linenflow.com). Set a strong value so the
# public default 'Admin123!' is never used. Applied only on the first seed; a later
# change is not overwritten on restart.
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Public origin of the frontend, used for API CORS (browser -> backend).
# Same-origin deploy: this is just https://DOMAIN (no port).
CORS_ORIGIN=https://your-domain.example

# Public URL the browser uses to reach the backend API (inlined at build time).
# Same origin as the app, path /v1 — Caddy proxies /v1/* to the backend.
NEXT_PUBLIC_API_URL=https://your-domain.example/v1
