# ── LinenFlow™ API environment ──────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit the real .env.

# Server
PORT=8080
NODE_ENV=production

# Database — use EITHER DATABASE_URL, OR the discrete DB_* vars below.
# In docker-compose the host is the service name (e.g. "postgres"), not localhost.
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/linenflow
DB_HOST=postgres
DB_PORT=5432
DB_NAME=linenflow
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# JWT secrets — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM
JWT_REFRESH_EXPIRES_IN=7d

# CORS — the public origin of the frontend that is allowed to call this API.
CORS_ORIGIN=https://your-frontend-domain.example

# First-run superadmin password (admin@linenflow.com). Set a strong value so the
# public default 'Admin123!' is never used. Applied only on the first seed; a later
# change is not overwritten on restart.
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
